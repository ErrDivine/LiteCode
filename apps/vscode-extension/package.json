{
  "name": "marvis-vscode",
  "displayName": "Marvis Coding Agent OS",
  "description": "VSCode shell for the Marvis coding-agent runtime in lite-code.",
  "version": "0.1.0",
  "publisher": "errdivine",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:marvis.start",
    "onCommand:marvis.showStatus",
    "onCommand:marvis.refreshStatus",
    "onCommand:marvis.checkAutonomyNow",
    "onCommand:marvis.ask",
    "onCommand:marvis.askAboutSelection",
    "onCommand:marvis.fixNearCursor",
    "onCommand:marvis.explainDiagnostic",
    "onCommand:marvis.recordTerminalFailure",
    "onCommand:marvis.runCommandAndRecord",
    "onCommand:marvis.runTaskAndRecord"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "marvis.start",
        "title": "Start Marvis",
        "category": "Marvis"
      },
      {
        "command": "marvis.showStatus",
        "title": "Show Status",
        "category": "Marvis"
      },
      {
        "command": "marvis.refreshStatus",
        "title": "Refresh Status",
        "category": "Marvis"
      },
      {
        "command": "marvis.checkAutonomyNow",
        "title": "Check Autonomy Now",
        "category": "Marvis"
      },
      {
        "command": "marvis.ask",
        "title": "Ask Marvis",
        "category": "Marvis"
      },
      {
        "command": "marvis.askAboutSelection",
        "title": "Ask About Selection",
        "category": "Marvis"
      },
      {
        "command": "marvis.fixNearCursor",
        "title": "Fix Near Cursor",
        "category": "Marvis"
      },
      {
        "command": "marvis.explainDiagnostic",
        "title": "Explain Diagnostic",
        "category": "Marvis"
      },
      {
        "command": "marvis.recordTerminalFailure",
        "title": "Record Terminal Failure",
        "category": "Marvis"
      },
      {
        "command": "marvis.runCommandAndRecord",
        "title": "Run Command and Record Result",
        "category": "Marvis"
      },
      {
        "command": "marvis.runTaskAndRecord",
        "title": "Run VSCode Task and Record Result",
        "category": "Marvis"
      }
    ],
    "configuration": {
      "title": "Marvis",
      "properties": {
        "marvis.runtimePath": {
          "type": "string",
          "default": "",
          "description": "Optional path to the lite-code binary. If empty, the extension uses its packaged binary; development mode can also use target/debug/lite-code."
        },
        "marvis.model": {
          "type": "string",
          "default": "gpt-4.1-mini",
          "description": "Model name passed to the Rust runtime."
        },
        "marvis.apiKey": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "API key for the OpenAI-compatible provider used by the VSCode runtime. Store this in User or Machine Settings, not committed workspace settings."
        },
        "marvis.baseUrl": {
          "type": "string",
          "default": "",
          "description": "Optional OpenAI-compatible base URL. If empty, the Rust runtime uses MARVIS_BASE_URL or https://api.openai.com/v1."
        },
        "marvis.thinkingMode": {
          "type": "string",
          "enum": [
            "auto",
            "disabled",
            "enabled",
            "provider_default"
          ],
          "default": "auto",
          "description": "Thinking mode for compatible providers. auto disables DeepSeek thinking by default and omits the parameter for other providers."
        },
        "marvis.reasoningEffort": {
          "type": "string",
          "enum": [
            "",
            "low",
            "medium",
            "high"
          ],
          "default": "",
          "description": "Optional reasoning effort sent to compatible providers when thinking is enabled or provider-default reasoning is requested."
        },
        "marvis.maxTokens": {
          "type": "number",
          "default": 4096,
          "description": "Maximum response tokens per model turn."
        },
        "marvis.autonomy.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Allow Marvis to wake up on VSCode status changes and suggest useful agent actions."
        },
        "marvis.autonomy.idleDelayMs": {
          "type": "number",
          "default": 3000,
          "description": "Delay before Marvis checks a quiet workspace status change."
        },
        "marvis.autonomy.heartbeatIntervalMs": {
          "type": "number",
          "default": 30000,
          "description": "Low-frequency autonomous status check interval while the runtime is active."
        }
      }
    },
    "menus": {
      "editor/context": [
        {
          "command": "marvis.askAboutSelection",
          "when": "editorTextFocus",
          "group": "navigation"
        },
        {
          "command": "marvis.fixNearCursor",
          "when": "editorTextFocus",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "check": "node --check extension.js"
  }
}
