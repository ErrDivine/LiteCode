{
  "name": "marvis-vscode",
  "displayName": "Marvis Coding Agent OS",
  "description": "VSCode shell for the Marvis coding-agent runtime in lite-code.",
  "version": "0.1.0",
  "publisher": "errdivine",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:marvis.start",
    "onCommand:marvis.showStatus",
    "onCommand:marvis.refreshStatus",
    "onCommand:marvis.checkAutonomyNow",
    "onCommand:marvis.ask",
    "onCommand:marvis.askAboutSelection",
    "onCommand:marvis.fixNearCursor",
    "onCommand:marvis.explainDiagnostic",
    "onCommand:marvis.recordTerminalFailure",
    "onCommand:marvis.runCommandAndRecord",
    "onCommand:marvis.runTaskAndRecord"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "marvis.start",
        "title": "Start Marvis",
        "category": "Marvis"
      },
      {
        "command": "marvis.showStatus",
        "title": "Show Status",
        "category": "Marvis"
      },
      {
        "command": "marvis.refreshStatus",
        "title": "Refresh Status",
        "category": "Marvis"
      },
      {
        "command": "marvis.checkAutonomyNow",
        "title": "Check Autonomy Now",
        "category": "Marvis"
      },
      {
        "command": "marvis.ask",
        "title": "Ask Marvis",
        "category": "Marvis"
      },
      {
        "command": "marvis.askAboutSelection",
        "title": "Ask About Selection",
        "category": "Marvis"
      },
      {
        "command": "marvis.fixNearCursor",
        "title": "Fix Near Cursor",
        "category": "Marvis"
      },
      {
        "command": "marvis.explainDiagnostic",
        "title": "Explain Diagnostic",
        "category": "Marvis"
      },
      {
        "command": "marvis.recordTerminalFailure",
        "title": "Record Terminal Failure",
        "category": "Marvis"
      },
      {
        "command": "marvis.runCommandAndRecord",
        "title": "Run Command and Record Result",
        "category": "Marvis"
      },
      {
        "command": "marvis.runTaskAndRecord",
        "title": "Run VSCode Task and Record Result",
        "category": "Marvis"
      }
    ],
    "configuration": {
      "title": "Marvis",
      "properties": {
        "marvis.runtimePath": {
          "type": "string",
          "default": "",
          "description": "Optional path to the lite-code binary. If empty, the extension uses its packaged binary; development mode can also use target/debug/lite-code."
        },
        "marvis.model": {
          "type": "string",
          "default": "gpt-4.1-mini",
          "description": "Model name passed to the Rust runtime."
        },
        "marvis.baseUrl": {
          "type": "string",
          "default": "",
          "description": "Optional OpenAI-compatible base URL. If empty, the Rust runtime uses MARVIS_BASE_URL or https://api.openai.com/v1."
        },
        "marvis.maxTokens": {
          "type": "number",
          "default": 4096,
          "description": "Maximum response tokens per model turn."
        },
        "marvis.autonomy.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Allow Marvis to wake up on VSCode status changes and suggest useful agent actions."
        },
        "marvis.autonomy.idleDelayMs": {
          "type": "number",
          "default": 3000,
          "description": "Delay before Marvis checks a quiet workspace status change."
        },
        "marvis.autonomy.heartbeatIntervalMs": {
          "type": "number",
          "default": 30000,
          "description": "Low-frequency autonomous status check interval while the runtime is active."
        },
        "marvis.agentProfiles": {
          "type": "array",
          "default": [
            {
              "id": "rust-diagnostic-repair",
              "label": "Rust Diagnostic Repair",
              "skills": [
                "rust-diagnostic-repair"
              ],
              "mcp_servers": [],
              "skill_prompt": "You are a Rust repair agent. Focus on compiler diagnostics, failing tests, and small verified patches.",
              "tool_allowlist": [
                "read_file",
                "read_many_files",
                "search_files",
                "find_files",
                "list_directory",
                "list_symbols",
                "apply_patch",
                "run_test",
                "run_build",
                "run_formatter",
                "git_diff",
                "git_status",
                "list_skills",
                "list_skill_resources",
                "read_skill_resource"
              ],
              "pave": {
                "rust": 1,
                "diagnostics": 0.95,
                "tests": 0.85,
                "patch": 0.9,
                "risk_medium": 0.5
              },
              "default_approval": {
                "allow_workspace_write": true,
                "allow_shell": true,
                "allow_risky_shell": false,
                "allow_git_write": false,
                "allow_network": false
              }
            },
            {
              "id": "test-failure-triage",
              "label": "Test Failure Triage",
              "skills": [
                "test-failure-triage"
              ],
              "mcp_servers": [],
              "skill_prompt": "You are a test failure triage agent. Explain the failing behavior, inspect focused code, and suggest the smallest verification path.",
              "tool_allowlist": [
                "read_file",
                "read_many_files",
                "search_files",
                "find_files",
                "list_directory",
                "list_symbols",
                "run_test",
                "git_diff",
                "git_status",
                "list_skills",
                "list_skill_resources",
                "read_skill_resource"
              ],
              "pave": {
                "tests": 1,
                "rust": 0.7,
                "diagnostics": 0.45,
                "explanation": 0.65,
                "shell": 0.5
              },
              "default_approval": {
                "allow_workspace_write": false,
                "allow_shell": true,
                "allow_risky_shell": false,
                "allow_git_write": false,
                "allow_network": false
              }
            },
            {
              "id": "repo-explainer",
              "label": "Repo Explainer",
              "skills": [
                "repo-explainer"
              ],
              "mcp_servers": [],
              "skill_prompt": "You are a repo explanation agent. Read only, summarize relationships, and avoid proposing edits unless the user asks.",
              "tool_allowlist": [
                "read_file",
                "read_many_files",
                "search_files",
                "find_files",
                "list_directory",
                "list_symbols",
                "git_diff",
                "git_status",
                "list_skills",
                "list_skill_resources",
                "read_skill_resource"
              ],
              "pave": {
                "explanation": 1,
                "docs": 0.65,
                "rust": 0.35,
                "risk_low": 0.6
              },
              "default_approval": {
                "allow_workspace_write": false,
                "allow_shell": false,
                "allow_risky_shell": false,
                "allow_git_write": false,
                "allow_network": false
              }
            }
          ],
          "description": "Agent profiles used by autonomous PAVE routing. Profiles choose model names, skills, tool allowlists, and vectors; API credentials still come only from MARVIS_API_KEY and MARVIS_BASE_URL."
        }
      }
    },
    "menus": {
      "editor/context": [
        {
          "command": "marvis.askAboutSelection",
          "when": "editorTextFocus",
          "group": "navigation"
        },
        {
          "command": "marvis.fixNearCursor",
          "when": "editorTextFocus",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "check": "node --check extension.js"
  }
}
